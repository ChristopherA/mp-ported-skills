{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/skills/resuming/scripts/state.sh\" --hook </dev/null",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/session-title.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
